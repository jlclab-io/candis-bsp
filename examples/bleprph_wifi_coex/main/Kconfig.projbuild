menu "Candis Wi-Fi and BLE coexistence example"

    config EXAMPLE_ESP_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            SSID (network name) for the example to connect to.

    config EXAMPLE_ESP_WIFI_PASSWORD
        string "WiFi Password"
        default ""
        help
            Wi-Fi password for the example access point.

    config EXAMPLE_ESP_MAXIMUM_RETRY
        int "WIFI Connect Maximum retry"
        default 5
        help
            Set the Maximum retry to avoid station reconnecting to the AP unlimited when the AP is really inexistent.

    config EXAMPLE_HTTP_URL
        string "HTTP URL for internet check"
        default "http://example.com/"
        help
            Plain HTTP endpoint used to verify internet access after the station gets an IP address.
endmenu
