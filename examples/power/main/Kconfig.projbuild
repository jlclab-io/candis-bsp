menu "Candis TG28-ESP example"

config CANDIS_POWER_DEMO_PANEL_POWER
    bool "Allow the example to power the verified 3.3 V AMOLED fixture"
    default n

config CANDIS_POWER_DEMO_CHARGE_TEST
    bool "Enable the supervised 25 mA charge setpoint test"
    default n
    help
        Adds a two-step touchscreen action that temporarily reduces the
        200 mA setpoint to 25 mA during constant-current charging.

endmenu
