menu "Candis display example"

config CANDIS_BENCH_PANEL_POWER
    bool "Allow the example to enable the AMOLED rail"
    default n
    help
        Enable for a measured setup compatible with a nominal 3.3 V ALDO1.

config CANDIS_BENCH_QSPI_50MHZ
    bool "Use 50 MHz QSPI for comparison"
    default n

config CANDIS_BENCH_AUTORUN
    bool "Automatically measure partial, full and scan refresh and restart the display"
    default n

config CANDIS_BENCH_ROUNDS
    int "Refresh benchmark and restart cycles"
    depends on CANDIS_BENCH_AUTORUN
    range 1 100
    default 1

config CANDIS_BENCH_SYNC_FLUSH
    bool "Use synchronous AMOLED transfers for comparison"
    default n
    help
        Use one PSRAM framebuffer and wait for panel IO inside the LVGL refresh.

endmenu
